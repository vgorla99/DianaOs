# Copy to .env and fill in your own values. Never commit .env.
# At least one provider key is required for real LLM calls; MOCK_LLM=true
# runs the whole stack offline/deterministically without any of them.

# --- LLM providers (set the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# --- Test / offline mode ---
# true: core/llm.py returns a fixed mock response, no real API call, no cost.
MOCK_LLM=true

# --- Profile (see core/settings.py) ---
# local | lan | hosted-demo | test
DIANA_PROFILE=local

# --- Where your own instance/config/ lives (see core/control_plane/config_loader.py) ---
# Defaults to ./instance/config - override if you keep it elsewhere.
INSTANCE_CONFIG_ROOT=instance/config

# --- Optional integrations ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
